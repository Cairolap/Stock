{
  "name": "stock-management-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/core.js && node --check src/worker.js && node --check public/app.js && node --check public/image-scaler.js && node --check scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create stock-management",
    "db:migrate:local": "wrangler d1 execute stock-management --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute stock-management --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
